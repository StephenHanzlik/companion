{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "companion",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],

  // Frontend: the Vite production build. Only /api/* and /healthz invoke the
  // Worker below; everything else is served as a static asset directly.
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },

  // Backend: the existing Go binary, unchanged, run as a Container.
  "containers": [
    {
      "class_name": "BackendContainer",
      "image": "../backend/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "BackendContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BackendContainer"]
    }
  ],

  // Every domain must be listed here: wrangler deploy treats this list as the
  // full set, so a domain added only in the dashboard is removed on the next
  // deploy (DNS record included).
  "routes": [
    {
      "pattern": "avycompanion.coldmountainsoftware.com",
      "custom_domain": true
    },
    {
      "pattern": "companion.coldmountainsoftware.com",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true
  }
}
